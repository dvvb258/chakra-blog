# ==============================================================================
# 生产环境配置 (Production) - 可通过 Docker 容器环境变量动态覆盖
# ==============================================================================

# 站点公网主域名
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Docker Compose 容器网络中 .NET WebAPI 服务地址（服务端 SSR 直连 + 浏览器 /api 反向代理统一使用）
INTERNAL_API_BASE_URL=http://blogapi:8080/api
