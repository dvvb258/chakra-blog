# ==============================================================================
# Chakra - 现代化昼夜双生全栈个人技术博客系统 (Docker Compose 环境变量模板)
# 使用方法：复制本文件为 .env（cp .env.example .env），并根据实际需求修改配置
# ==============================================================================

# 1. 数据库配置 (PostgreSQL)
POSTGRES_DB=blog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# 2. 外部映射访问端口
BLOG_PORT=3000          # 读者展示端端口
ADMIN_PORT=3101         # 博主管理后台端口
API_PORT=5000           # 后端 WebAPI 端口

# 3. 站点公网访问主域名（展示端 SEO / Sitemap）
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 4. 安全签名密钥 (JWT) 与跨域白名单 (CORS)
# 生产环境请务必替换为一个至少 32 字符的强随机字符串！
JWT_SECRET=CHANGE_ME_SecureJwtSecretKeyMustBeLongerThan32Bytes!
# 自定义跨域白名单（多个公网域名使用半角逗号分隔；默认已内置包含 NEXT_PUBLIC_SITE_URL 与本地开发端口）
# CORS_ALLOWED_ORIGINS=https://myblog.com,https://admin.myblog.com

# 5. 可选高级特性配置（若需要开启可取消注释并填入实际凭据）
# ------------------------------------------------------------------------------
# 5.1 Redis 缓存（默认 false，开启时需提供连接串）
# REDIS_ENABLED=false
# REDIS_CONNECTION_STRING=redis:6379,password=,defaultDatabase=0

# 5.2 对象存储模式（默认 Local 本地磁盘；可选 S3 兼容 MinIO/OSS/Cloudflare R2/AWS）
# STORAGE_PROVIDER=Local
# S3_ENDPOINT=https://s3.amazonaws.com
# S3_BUCKET=my-bucket
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_PUBLIC_URL=https://cdn.example.com

# 5.3 AI 文章智能辅助撰写（默认 false）
# AI_AUTOGEN_ENABLED=false
# AI_KEY=
# AI_ENDPOINT=https://api.openai.com/v1
# AI_MODEL_NAME=gpt-4o-mini
# AI 抓取并参考的技术文章 RSS 数据源（支持多个，英文逗号分隔）
# AI_RSS_SOURCES=https://devblogs.microsoft.com/dotnet/feed/,https://devblogs.microsoft.com/aspnet/feed/

# 5.4 GitHub 第三方快捷登录（默认 false）
# GITHUB_ENABLED=false
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_REDIRECT_URI=http://localhost:3101/login

# 5.5 开发运维控制面板（默认开启）
# SWAGGER_ENABLED=true
# HANGFIRE_DASHBOARD_ENABLED=true
# HANGFIRE_USERNAME=admin
# HANGFIRE_PASSWORD=CHANGE_ME_HangfireSecurePassword!
