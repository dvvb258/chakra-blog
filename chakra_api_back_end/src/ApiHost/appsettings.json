{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "MediatR.Licensing": "None"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3000",
      "http://localhost:3101",
      "http://127.0.0.1:3000",
      "http://127.0.0.1:3101"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=blog;Username=postgres;Password=postgres;Keepalive=30;Minimum Pool Size=1;Connection Idle Lifetime=300;",
    "Redis": "redis:6379"
  },
  "Redis": {
    "Enabled": false
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "UploadDir": "uploads",
      "RequestPath": "/uploads",
      "PublicUrl": ""
    },
    "S3": {
      "ServiceUrl": "https://s3.your-region.amazonaws.com",
      "AccessKey": "YOUR_S3_ACCESS_KEY",
      "SecretKey": "YOUR_S3_SECRET_KEY",
      "BucketName": "your-bucket-name",
      "Region": "auto",
      "PublicUrl": "",
      "ForcePathStyle": true
    }
  },
  "AISettings": {
    "AutoGenerateEnabled": false,
    "Key": "CHANGE_ME_OR_LEAVE_EMPTY",
    "Endpoint": "https://api.openai.com/v1",
    "ModelName": "gpt-4o-mini"
  },
  "SnowflakeId": {
    "WorkerId": 1
  },
  "Hangfire": {
    "Dashboard": {
      "Username": "admin",
      "Password": "AdminPassword123!"
    }
  },
  "JwtSettings": {
    "Secret": "CHANGE_ME_SecureJwtSecretKeyMustBeLongerThan32Bytes!",
    "Issuer": "chakra_api",
    "Audience": "chakra_client",
    "AccessTokenExpirationMinutes": 120,
    "RefreshTokenExpirationDays": 7
  },
  "Identity": {
    "GitHub": {
      "Enabled": false,
      "ClientId": "YOUR_GITHUB_CLIENT_ID",
      "ClientSecret": "YOUR_GITHUB_CLIENT_SECRET",
      "RedirectUri": "http://localhost:3101/login"
    }
  }
}
