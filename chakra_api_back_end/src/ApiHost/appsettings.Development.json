{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "MediatR.Licensing": "None"
    }
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:3101",
      "http://localhost:3000",
      "http://127.0.0.1:3101",
      "http://127.0.0.1:3000"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=blog;Username=postgres;Password=postgres;Keepalive=30;Minimum Pool Size=1;Connection Idle Lifetime=300;",
    "Redis": "localhost:6379"
  },
  "Redis": {
    "Enabled": false
  },
  "Storage": {
    "Provider": "Local",
    "Local": {
      "UploadDir": "uploads",
      "RequestPath": "/uploads",
      "PublicUrl": ""
    }
  },
  "AISettings": {
    "AutoGenerateEnabled": false
  },
  "Identity": {
    "GitHub": {
      "Enabled": false,
      "ClientId": "YOUR_GITHUB_CLIENT_ID",
      "ClientSecret": "YOUR_GITHUB_CLIENT_SECRET",
      "RedirectUri": "http://localhost:3101/login"
    }
  }
}
